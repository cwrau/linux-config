[Unit]
Description=mcp-memory-service
After=graphical-session.target
PartOf=graphical-session.target

[Container]
Image=docker.io/doobidoo/mcp-memory-service:latest
Network=host
Volume=%h/.local/share/mcp-memory-service:/app/data
Environment=MCP_MODE=streamable-http
Environment=MCP_SSE_HOST=127.0.0.1
Environment=MCP_SSE_PORT=8765
Environment=MCP_MEMORY_STORAGE_BACKEND=sqlite_vec
Environment=MCP_MEMORY_SQLITE_PATH=/app/data/sqlite_vec.db
Environment=MCP_MEMORY_BACKUPS_PATH=/app/data/backups
Environment=LOG_LEVEL=INFO

[Service]
Restart=on-failure
