// Waybar dual-bar config — ported from polybar
// Top bar: system status + tags + controls
// Bottom bar: media + system monitors + systemd status
[
  // ═══════════════════════════════════════════
  // TOP BAR
  // ═══════════════════════════════════════════
  {
    "layer": "top",
    "position": "top",
    "height": 54, // __TOP_HEIGHT__
    "spacing": 3,

    "modules-left": [
      "custom/bluetooth",
      "network",
      "custom/wired",
      "battery"
    ],
    "modules-center": [
      "dwl/tags",
      "sway/workspaces",
      "sway/mode",
      "hyprland/workspaces"
    ],
    "modules-right": [
      "custom/notifications",
      "custom/microphone",
      "custom/screenshare",
      "custom/anlage",
      "custom/ringlicht",
      "custom/fernsehen",
      "custom/pulse-restart",
      "pulseaudio",
      "custom/current-player",
      "clock"
    ],

    // ── Built-in modules ──

    "dwl/tags": {
      "num-tags": 9,
      "tag-labels": ["\uf0b1", "\uf121", "\uf015", "\uf144", "\uf11b", "\uf120", "\uf232", "\uf27a", "\uf392"]
    },

    "sway/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "format": "{name}"
    },

    "sway/mode": {
      "format": "<span style=\"italic\">{}</span>"
    },

    "hyprland/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "format": "{name}"
    },

    "clock": {
      "format": "{:%Y-%m-%dT%H:%M:%S%z (%a/%b)}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "interval": 1
    },

    "battery": {
      "bat": "BAT0",
      "interval": 2,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}% ({time} {power:.1f}W)",
      "format-charging": "\uf0e7 {capacity}% ({time} +{power:.1f}W)",
      "format-plugged": "\uf1e6 {capacity}%",
      "format-full": "\uf240",
      "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    },

    "network": {
      "interface": "wl*",
      "format-wifi": "\uf1eb {essid} {ipaddr}",
      "format-ethernet": "\uf6ff {ipaddr}/{cidr}",
      "format-linked": "\uf6ff {ifname} (No IP)",
      "format-disconnected": "\uf1eb",
      "tooltip-format": "{ifname} via {gwaddr}",
      "on-click": "networkmanager_dmenu"
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}%",
      "format-muted": "\uf6a9 {volume}%",
      "format-source": "\uf130 {volume}%",
      "format-source-muted": "\uf131",
      "format-icons": {
        "headphone": "\uf025",
        "hands-free": "\uf590",
        "headset": "\uf590",
        "phone": "\uf095",
        "portable": "\uf001",
        "car": "\uf1b9",
        "default": ["\uf026", "\uf027", "\uf028"]
      },
      "on-click": "pavucontrol",
      "on-click-right": "audio_sink",
      "on-click-middle": "audio_program_sink"
    },

    "custom/current-player": {
      "exec": "pctl PRINT -f",
      "on-click": "pctl NEXT",
      "on-scroll-up": "pctl volume 0.05+",
      "on-scroll-down": "pctl volume 0.05-"
    },

    // ── Custom modules (top bar) ──

    "custom/bluetooth": {
      "exec": "~/.config/bar/scripts/bluetooth.sh",
      "return-type": "json",
      "escape": false,
      "on-click": "bluetooth_dmenu",
      "on-click-right": "~/.config/bar/scripts/bluetooth.sh --toggle",
      "restart-interval": 0
    },

    "custom/wired": {
      "exec": "~/.config/bar/scripts/wired.sh",
      "return-type": "json",
      "interval": 1
    },

    "custom/notifications": {
      "exec": "~/.config/bar/scripts/notifications.sh",
      "return-type": "json",
      "escape": false,
      "on-click": "dunstctl set-paused toggle",
      "restart-interval": 0
    },

    "custom/microphone": {
      "exec": "~/.config/bar/scripts/microphone.sh",
      "return-type": "json",
      "escape": false,
      "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
      "restart-interval": 0
    },

    "custom/screenshare": {
      "exec": "~/.config/bar/scripts/screenshare.sh",
      "return-type": "json",
      "escape": false,
      "restart-interval": 0
    },

    "custom/anlage": {
      "exec": "~/.config/bar/scripts/ha-toggle.sh anlage",
      "return-type": "json",
      "escape": false,
      "on-click": "kill -USR1 $(cat $XDG_RUNTIME_DIR/bar/ha-toggle-anlage.pid)",
      "restart-interval": 0
    },

    "custom/ringlicht": {
      "exec": "~/.config/bar/scripts/ha-toggle.sh ringlicht",
      "return-type": "json",
      "escape": false,
      "on-click": "kill -USR1 $(cat $XDG_RUNTIME_DIR/bar/ha-toggle-ringlicht.pid)",
      "restart-interval": 0
    },

    "custom/fernsehen": {
      "exec": "~/.config/bar/scripts/ha-toggle.sh fernsehen",
      "return-type": "json",
      "escape": false,
      "on-click": "kill -USR1 $(cat $XDG_RUNTIME_DIR/bar/ha-toggle-fernsehen.pid)",
      "restart-interval": 0
    },

    "custom/pulse-restart": {
      "format": "",
      "on-click": "systemctl --user restart pipewire-pulse.service pipewire.service",
      "tooltip": false
    },

  },

  // ═══════════════════════════════════════════
  // BOTTOM BAR
  // ═══════════════════════════════════════════
  {
    "layer": "top",
    "position": "bottom",
    "height": 43, // __BOT_HEIGHT__
    "spacing": 3,

    "modules-left": [
      "mpris"
    ],
    "modules-center": [
      "cpu",
      "memory",
      "temperature",
      "disk",
      "custom/work",
      "custom/messengers",
      "custom/glava",
      "custom/gamemode"
    ],
    "modules-right": [
      "custom/systemd-status"
    ],

    // ── Built-in modules (bottom bar) ──

    "cpu": {
      "format": "\uf2db {usage:>3}%",
      "interval": 1,
      "on-click": "terminal -e btop",
      "tooltip": false
    },

    "memory": {
      "format": "\uf538 {used:0.1f}G ({percentage}%) | {swapUsed:0.1f}G ({swapPercentage}%)",
      "interval": 1,
      "on-click": "terminal -e btop"
    },

    "temperature": {
      "thermal-zone": 0,
      "critical-threshold": 80,
      "format": "{icon} {temperatureC}°C",
      "format-critical": "{icon} {temperatureC}°C",
      "format-icons": ["\uf2cb", "\uf2ca", "\uf2c9", "\uf2c8", "\uf2c7"],
      "interval": 1
    },

    "disk": {
      "path": "/",
      "format": "\uf0a0 {free}",
      "interval": 10,
      "on-click": "pcmanfm ~"
    },

    // ── Custom modules (bottom bar) ──

    "mpris": {
      "format": "{position}/{length}  {artist} - {title}",
      "format-paused": "{position}/{length}  {artist} - {title}",
      "format-stopped": "",
      "status-icons": {
        "playing": "\uf144",
        "paused": "\uf28b",
        "stopped": "\uf28d"
      },
      "interval": 1,
      "ignored-players": ["kdeconnect"],
      "on-click": "play-pause",
      "on-click-middle": "previous",
      "on-click-right": "next",
      "artist-len": 30,
      "title-len": 60,
      "tooltip-format": "{artist} - {title}\n{album}"
    },

    "custom/work": {
      "exec": "~/.config/bar/scripts/systemd-display.sh work.target \ue066",
      "return-type": "json",
      "escape": false,
      "on-click": "~/.config/bar/scripts/systemd-click.sh work.target",
      "restart-interval": 0
    },

    "custom/messengers": {
      "exec": "~/.config/bar/scripts/systemd-display.sh messengers.target \uf086",
      "return-type": "json",
      "escape": false,
      "on-click": "~/.config/bar/scripts/systemd-click.sh messengers.target",
      "restart-interval": 0
    },

    "custom/glava": {
      "exec": "~/.config/bar/scripts/systemd-display.sh glava.target \uf83e",
      "return-type": "json",
      "escape": false,
      "on-click": "~/.config/bar/scripts/systemd-click.sh glava.target",
      "restart-interval": 0
    },

    "custom/gamemode": {
      "exec": "~/.config/bar/scripts/systemd-display.sh gamemode.service \uf11b gamemode.target",
      "return-type": "json",
      "escape": false,
      "on-click": "~/.config/bar/scripts/systemd-click.sh gamemode.service",
      "restart-interval": 0
    },

    "custom/systemd-status": {
      "exec": "~/.config/bar/scripts/systemd-status.sh",
      "return-type": "json",
      "escape": false,
      "restart-interval": 0
    },

  }
]
