[Unit]
Description=Lower music volume during service activation
StopWhenUnneeded=true

[Service]
Type=oneshot
ExecStart=-bash -x /usr/local/bin/pctl -s youtube-music-player.service volume %i
RemainAfterExit=true
ExecStop=-bash -x /usr/local/bin/pctl -s youtube-music-player.service volume 100

RestrictNamespaces=true
