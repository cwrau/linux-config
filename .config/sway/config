# sway config — VT3
# Shared session services (kanshi, swaybg, swayidle, waybar, clipman) are
# started by wayland.target via sway-session.target.

set $super Mod4
set $alt   Mod1

# ── Font ──────────────────────────────────────────────────────────────────────
font pango:monospace 9

# ── XWayland ──────────────────────────────────────────────────────────────────
xwayland enable

# ── Input ─────────────────────────────────────────────────────────────────────
input "type:keyboard" {
    xkb_layout  us,de
    repeat_rate  25
    repeat_delay 200
}

input "type:touchpad" {
    tap             enabled
    drag            enabled
    natural_scroll  disabled
    click_method    clickfinger
    dwt             disabled
    scroll_method   two_finger
    accel_profile   flat
    pointer_accel   0.0
}

seat * xcursor_theme Breeze_Hacked 24
seat * hide_cursor 3000

# ── Appearance ────────────────────────────────────────────────────────────────
default_border pixel 1
hide_edge_borders both
gaps outer 5
gaps inner 10
smart_borders on

for_window [app_id=".*"] opacity 0.9
for_window [class=".*"]  opacity 0.9
# YMP stays semi-transparent regardless of focus (must follow generic rule)
for_window [app_id="youtube-music-desktop-app"]    opacity 0.5
for_window [app_id="YouTube Music Desktop App"]    opacity 0.5
for_window [app_id="ytm"]                          opacity 0.5

focus_follows_mouse yes
focus_on_window_activation urgent
floating_modifier $super normal

# ── Window Rules — Floating ───────────────────────────────────────────────────
for_window [app_id="jetbrains-toolbox"]                              floating enable
for_window [app_id="steam_app_.*"]                                   floating enable
for_window [app_id="steamwebhelper"]                                 floating enable
for_window [app_id="sun-awt-X11-XWindowPeer"]                        floating enable
for_window [app_id="java-lang-Thread"]                               floating enable
for_window [app_id="Gnome-network-displays"]                         floating enable
for_window [app_id="gnome-network-displays"]                         floating enable
for_window [app_id="AusweisApp"]                                     floating enable
for_window [title="AusweisApp"]                                      floating enable
# JetBrains IDE popups
for_window [app_id="jetbrains-.*" title="win0"]                      floating enable
for_window [app_id="jetbrains-.*" title="Welcome to IntelliJ IDEA"]  floating enable
for_window [app_id="jetbrains-.*" title="splash"]                    floating enable
for_window [app_id="jetbrains-.*" title="Get from Version Control"]  floating enable
for_window [app_id="jetbrains-.*" title="Clone Repository"]          floating enable
for_window [app_id="jetbrains-.*" title="Debug"]                     floating disable
# XWayland fallbacks
for_window [class="jetbrains-toolbox"]                               floating enable
for_window [class="steam_app.*"]                                     floating enable
for_window [class="Gnome-network-displays"]                          floating enable
for_window [class="Kazam"]                                           floating enable
for_window [class="jetbrains-.*" title="win0"]                       floating enable
for_window [class="jetbrains-.*" title="Welcome to IntelliJ IDEA"]   floating enable
for_window [class="jetbrains-.*" title="Debug"]                      floating disable
# Screen sharing indicator: sticky (all workspaces on its output), no border
for_window [title=".*is sharing your screen.*"]  sticky enable, border none
# Updates scratchpad (X11 window_role)
for_window [window_role="UPDATES"]               move scratchpad

# ── Workspace Assignments ─────────────────────────────────────────────────────
# Workspace 1: Work
assign [app_id="thunderbird"]           workspace 1
assign [app_id="work"]                  workspace 1
assign [app_id="work-todo"]             workspace 1
assign [app_id="telefondienst"]         workspace 1
assign [app_id="daily"]                 workspace 1
assign [app_id="org.gabmus.gfeeds"]     workspace 1
assign [class="Thunderbird"]            workspace 1
assign [class="work"]                   workspace 1
# GMail browser instance (title set after open — use for_window)
for_window [app_id="stuff" title="^_GMail$"]   move to workspace 1

# Workspace 14: Discord
assign [app_id="discord"]   workspace 14:Discord
assign [app_id="vesktop"]   workspace 14:Discord

# Workspace 15: Steam
assign [app_id="steam"]     workspace 15:Steam
assign [class="Steam"]      workspace 15:Steam

# Workspace 16: YouTube (title-based — browser sets title after open)
for_window [app_id="stuff" title="^_YouTube$"]   move to workspace 16:YouTube

# Workspace 17: Netflix
for_window [app_id="stuff" title="^_Netflix.*$"] move to workspace 17:Netflix
for_window [app_id="stuff" title="^_Anime.*$"]   move to workspace 17:Netflix

# Workspace 18: YMP
assign [app_id="youtube-music-desktop-app"]   workspace 18:YMP
assign [app_id="YouTube Music Desktop App"]   workspace 18:YMP
assign [app_id="ytm"]                         workspace 18:YMP

# Workspace 19: RocketChat
assign [app_id="Rocket.Chat"]   workspace 19:RocketChat
assign [app_id="rocketchat"]    workspace 19:RocketChat
# Work chat instances
assign [app_id="meeting"]       workspace 19:RocketChat
assign [app_id="work-slack"]    workspace 19:RocketChat

# Workspace 20: Chat
assign [app_id="Slack"]                   workspace 20:Chat
assign [app_id="slack"]                   workspace 20:Chat
assign [app_id="Signal"]                  workspace 20:Chat
assign [app_id="signal"]                  workspace 20:Chat
assign [app_id="TelegramDesktop"]         workspace 20:Chat
assign [app_id="org.telegram.desktop"]    workspace 20:Chat
assign [app_id="whatsapp"]                workspace 20:Chat
assign [class="Slack"]                    workspace 20:Chat
assign [class="Signal"]                   workspace 20:Chat
assign [class="TelegramDesktop"]          workspace 20:Chat

# ── Output Preferences ────────────────────────────────────────────────────────
# Output names match kanshi config (wayland names, not X11)
set $internal  eDP-1
set $external  HDMI-A-1
set $ext2      DP-1
set $ext3      DP-2
set $ext4      DP-5

workspace 1             output $external $ext2 $ext3 $ext4 $internal
workspace 14:Discord    output $internal
workspace 15:Steam      output $external $ext2 $ext3 $ext4 $internal
workspace 16:YouTube    output $external $ext2 $ext3 $ext4 $internal
workspace 17:Netflix    output $external $ext2 $ext3 $ext4 $internal
workspace 18:YMP        output $internal
workspace 19:RocketChat output $internal
workspace 20:Chat       output $internal

# ── Keybindings — Window Management ──────────────────────────────────────────
bindsym $super+Return       exec terminal
bindsym $super+Shift+q      kill
bindsym $alt+F4             exec true

bindsym $super+Left         focus left
bindsym $super+Down         focus down
bindsym $super+Up           focus up
bindsym $super+Right        focus right

bindsym $super+Shift+Left   move left
bindsym $super+Shift+Down   move down
bindsym $super+Shift+Up     move up
bindsym $super+Shift+Right  move right

bindsym $super+h            split v
bindsym $super+v            split h
bindsym $super+f            fullscreen toggle
bindsym $super+t            layout toggle stacking tabbed
bindsym $super+e            layout toggle split
bindsym $super+Shift+space  floating toggle
bindsym $super+Shift+r      reload

# ── Resize Mode ───────────────────────────────────────────────────────────────
mode "resize" {
    bindsym Left      resize shrink width  50px
    bindsym Down      resize grow   height 50px
    bindsym Up        resize shrink height 50px
    bindsym Right     resize grow   width  50px
    bindsym j         resize shrink width  50px
    bindsym k         resize grow   height 50px
    bindsym l         resize shrink height 50px
    bindsym semicolon resize grow   width  50px
    bindsym Escape    mode "default"
    bindsym Return    mode "default"
}
bindsym $super+r mode "resize"

# ── Power Mode ────────────────────────────────────────────────────────────────
set $power " [s]leep [p]oweroff [l]ogoff [r]eboot"
mode $power {
    bindsym s exec loginctl lock-session && sleep 1 && systemctl suspend; mode "default"
    bindsym p exec systemctl poweroff
    bindsym r exec systemctl reboot
    bindsym l exec swaymsg exit
    bindsym Escape mode "default"
}
bindsym $super+q mode $power

# ── App Launchers ─────────────────────────────────────────────────────────────
bindsym $super+d       exec timeout 10 rofi -show drun
bindsym $super+c       exec browser
bindsym $super+Shift+c exec browser --incognito
bindsym $super+m       exec systemctl --user restart browser@meeting.service
bindsym $super+Shift+m exec systemctl --user stop browser@meeting.service browser@daily.service
bindsym $super+p       exec timeout 30 open_project
bindsym $super+g       exec sh -c 'timeout 120 rofi -show calc -location 2 -automatic-save-to-history -no-fixed-num-lines -no-show-match -no-sort -calc-command "echo -n {result} | wl-copy"'

# ── Notifications ─────────────────────────────────────────────────────────────
bindsym Ctrl+space        exec dunstctl close
bindsym Ctrl+grave        exec dunstctl history-pop
bindsym Ctrl+Shift+period exec dunstctl context

# ── Audio ─────────────────────────────────────────────────────────────────────
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && pactl set-sink-mute @DEFAULT_SINK@ 0
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym Shift+XF86AudioMute  exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioMicMute     exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym $super+Ctrl+Shift+o  exec audio_program_volume
bindsym $super+Shift+o       exec audio_program_sink
bindsym $super+Ctrl+o        exec audio_profile
bindsym $super+o             exec audio_sink

# ── Brightness ────────────────────────────────────────────────────────────────
bindsym XF86MonBrightnessUp   exec brightness up
bindsym XF86MonBrightnessDown exec brightness down

# ── Media ─────────────────────────────────────────────────────────────────────
bindsym XF86AudioPlay         exec pctl play-pause
bindsym Shift+XF86AudioPlay   exec pctl NEXT
bindsym XF86AudioPause        exec pctl pause
bindsym XF86AudioNext         exec pctl next
bindsym Shift+XF86AudioNext   exec pctl position 5+
bindsym XF86AudioPrev         exec pctl previous
bindsym Shift+XF86AudioPrev   exec pctl position 5-
bindcode 164                  exec pctl play-pause
bindsym --whole-window button9              exec pctl next
bindsym --whole-window Shift+button9        exec pctl position 5+
bindsym --whole-window Shift+button8        exec pctl position 5-

# ── Display / Connectivity ────────────────────────────────────────────────────
bindsym $super+Shift+p    exec timeout 30 rofi-randr
bindsym $super+Ctrl+p     exec timeout 30 autorandr_dmenu
bindsym XF86Display       exec timeout 30 autorandr_dmenu
bindsym Shift+XF86Display exec timeout 30 rofi-randr
bindsym $super+b          exec timeout 10 bluetooth_dmenu
bindsym $super+i          exec timeout 30 networkmanager_dmenu -i
bindsym $super+u          exec timeout 10 udiskie-dmenu

# ── Lock ──────────────────────────────────────────────────────────────────────
bindsym $super+l exec loginctl lock-session

# ── Keyboard Layout ───────────────────────────────────────────────────────────
bindsym $super+k exec swaymsg input type:keyboard xkb_switch_layout next

# ── Emoji ─────────────────────────────────────────────────────────────────────
bindsym $super+period exec sh -c 'timeout 30 bemoji -c -n && ydotool key 29:1 42:1 47:1 47:0 42:0 29:0'

# ── Force-kill (fires on key release) ─────────────────────────────────────────
bindsym --release $super+x kill

# ── Clipboard ─────────────────────────────────────────────────────────────────
bindsym $super+Ctrl+v  exec sh -c 'clipman pick -t rofi -T"-i" --err-on-no-selection && wtype "$(wl-paste)"'
bindsym $super+Shift+v exec sh -c 'clipman pick -t rofi -T"-i" --err-on-no-selection && ydotool key 29:1 42:1 47:1 47:0 42:0 29:0'

# ── Screenshots (--release avoids capturing keybinding UI) ───────────────────
bindsym --release Print                   exec screenshot selection clipboard
bindsym --release Shift+Print             exec screenshot full clipboard
bindsym --release $super+Shift+Print      exec screenshot window clipboard
bindsym --release Ctrl+Print              exec screenshot selection --
bindsym --release Ctrl+Shift+Print        exec screenshot full --
bindsym --release Ctrl+Shift+$super+Print exec screenshot window --
bindsym --release $super+Print            exec screenshot screen-replay

# ── Scratchpad ────────────────────────────────────────────────────────────────
bindsym $super+Shift+u scratchpad show

# ── Waybar Toggle ─────────────────────────────────────────────────────────────
bindsym $super+Shift+f exec sh -c 'if systemctl --user -q is-active waybar; then systemctl --user stop waybar; else systemctl --user start waybar; fi'

# ── Workspace Navigation ──────────────────────────────────────────────────────
bindsym $super+Page_Up   workspace prev
bindsym $super+Page_Down workspace next

# ── Monitor Focus / Move ──────────────────────────────────────────────────────
bindsym $super+Ctrl+Left        focus output left
bindsym $super+Ctrl+Right       focus output right
bindsym $super+Ctrl+Up          focus output up
bindsym $super+Ctrl+Down        focus output down
bindsym $super+Ctrl+Shift+Left  move container to output left
bindsym $super+Ctrl+Shift+Right move container to output right
bindsym $super+Ctrl+Shift+Up    move container to output up
bindsym $super+Ctrl+Shift+Down  move container to output down

# ── Workspace Switching ───────────────────────────────────────────────────────
bindsym $super+1 workspace 1
bindsym $super+2 workspace 2
bindsym $super+3 workspace 3
bindsym $super+4 workspace 4
bindsym $super+5 workspace 5
bindsym $super+6 workspace 6
bindsym $super+7 workspace 7
bindsym $super+8 workspace 8
bindsym $super+9 workspace 9
bindsym $super+0 workspace 10

bindsym $super+$alt+1 workspace 11
bindsym $super+$alt+2 workspace 12
bindsym $super+$alt+3 workspace 13
bindsym $super+$alt+4 workspace 14:Discord
bindsym $super+$alt+5 workspace 15:Steam
bindsym $super+$alt+6 workspace 16:YouTube
bindsym $super+$alt+7 workspace 17:Netflix
bindsym $super+$alt+8 workspace 18:YMP
bindsym $super+$alt+9 workspace 19:RocketChat
bindsym $super+$alt+0 workspace 20:Chat

# ── Move Container to Workspace ───────────────────────────────────────────────
bindsym $super+Shift+1 move container to workspace 1
bindsym $super+Shift+2 move container to workspace 2
bindsym $super+Shift+3 move container to workspace 3
bindsym $super+Shift+4 move container to workspace 4
bindsym $super+Shift+5 move container to workspace 5
bindsym $super+Shift+6 move container to workspace 6
bindsym $super+Shift+7 move container to workspace 7
bindsym $super+Shift+8 move container to workspace 8
bindsym $super+Shift+9 move container to workspace 9
bindsym $super+Shift+0 move container to workspace 10

bindsym $super+Shift+$alt+1 move container to workspace 11
bindsym $super+Shift+$alt+2 move container to workspace 12
bindsym $super+Shift+$alt+3 move container to workspace 13
bindsym $super+Shift+$alt+4 move container to workspace 14:Discord
bindsym $super+Shift+$alt+5 move container to workspace 15:Steam
bindsym $super+Shift+$alt+6 move container to workspace 16:YouTube
bindsym $super+Shift+$alt+7 move container to workspace 17:Netflix
bindsym $super+Shift+$alt+8 move container to workspace 18:YMP
bindsym $super+Shift+$alt+9 move container to workspace 19:RocketChat
bindsym $super+Shift+$alt+0 move container to workspace 20:Chat

# ── Session Startup ───────────────────────────────────────────────────────────
exec systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK DISPLAY \
  && systemctl --user start sway-session.target
