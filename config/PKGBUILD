if grep -iq AMD /proc/cpuinfo; then
  depends+=(amd-ucode)
else
  depends+=(intel-ucode)
fi

if lspci | grep ' VGA ' | grep -q -i nvidia; then
  case n in
    o)
      depends+=(
        nvidia-dkms=580.119.02
        opencl-nvidia
        lib32-opencl-nvidia
        nvidia-utils
        lib32-nvidia-utils
      )
      ;;
    n)
      depends+=(
        nvidia-open
        opencl-nvidia
        lib32-opencl-nvidia
        nvidia-utils
        lib32-nvidia-utils
      )
      ;;
    5)
      depends+=(
        nvidia-580xx-dkms
        opencl-nvidia-580xx
        lib32-opencl-nvidia-580xx
        nvidia-580xx-utils
        lib32-nvidia-580xx-utils
      )
      ;;
    b)
      depends+=(
        nvidia-open-beta-dkms
        opencl-nvidia-beta
        lib32-opencl-nvidia-beta
        nvidia-utils-beta
        lib32-nvidia-utils-beta
      )
    ;;
  esac
fi

package() {
  tar -xf rootfs.tar -C "$pkgdir"
}
