#!/usr/bin/env bash

set -eu
set -o pipefail

export TMP_DIR="$(mktemp -d)"

trap 'rm -rf "$TMP_DIR"' EXIT

function sameNumberOfDocuments() {
  local oldGitPath="$1"
  local oldNumberOfDocuments
  local newGitPath="$2"
  local newNumberOfDocuments
  local tool="$3"

  oldNumberOfDocuments="$($tool -s length "$oldGitPath")"
  newNumberOfDocuments="$($tool -s length "$newGitPath")"

  if (((oldNumberOfDocuments + newNumberOfDocuments) == 1)) || ((oldNumberOfDocuments == newNumberOfDocuments)); then
    return 0
  else
    return 1
  fi
}

function getToolForFileType() {
  local filetype="$1"
  local oldGitPath="$2"
  local newGitPath="$3"
  local tool
  local tmpDir
  local filetype
  local newName
  case "$filetype" in
    application/yaml | application/*-yaml | application/*+yaml) ;&
    application/json | application/*-json | application/*+json)
      tool=yq
      ;;
    application/toml)
      tool=tomlq
      ;;
    application/xml | application/*-xml | application/*+xml) ;&
    text/xml | text/*-xml)
      tool=xq
      ;;
    text/plain)
      for path in "$oldGitPath" "$newGitPath"; do
        if [[ "$path" == *".ini" ]]; then
          tool=tomlq
          break
        fi
      done
      ;;
    application/x-trash)
      tmpDir="$(mktemp -d -p "$TMP_DIR")"
      for path in "$oldGitPath" "$newGitPath"; do
        newName="$(basename -s .bak "$path")"
        cp "$path" "$tmpDir/$newName"
        filetype="$(xdg-mime query filetype "$tmpDir/$newName")"
        if tool="$(getToolForFileType "$filetype" "$oldGitPath" "$newGitPath")"; then
          break
        fi
      done
      ;;
    *) ;;
  esac

  if [[ -v tool ]]; then
    echo "$tool"
  else
    return 1
  fi
}

function diffWithDyff() {
  local oldGitPath="$1"
  local newGitPath="$2"
  dyff --color on between --omit-header "$oldGitPath" "$newGitPath" | tail -n +2
}

function diffWith_xq() {
  local oldGitPath="$1"
  local newGitPath="$2"
  diffWithDyff <(xq . "$oldGitPath" | yq -y) <(xq . "$newGitPath" | yq -y)
}

function runTextConversion() {
  local filePath
  local gitPath
  if [[ "$#" -eq 2 ]]; then
    filePath="$1"
    gitPath="$2"
  elif [[ "$#" -eq 3 ]]; then
    if git check-attr -a -- "$2" &>/dev/null; then
      filePath="$1"
      gitPath="$2"
    elif git check-attr -a -- "$3" &>/dev/null; then
      filePath="$1"
      gitPath="$3"
    else
      return 1
    fi
  fi
  local newFilePath="$filePath"
  local attribute
  local tool
  local command

  if [[ -f "$gitPath" ]] && [[ -f "$filePath" ]]; then
    while read -d $'\0' -r attribute; do
      tool="$attribute" # the "last" attribute is the tool
    done < <(
      git check-attr -za -- "$gitPath" 2>/dev/null | grep --text $'\0diff\0'
    )
    if [[ -v tool ]] && command="$(git config get "diff.$tool.textconv")"; then
      newFilePath="$(mktemp --suffix="${filePath#*.}" -p "$TMP_DIR")"
      ${command} "$filePath" >"$newFilePath"
    fi
  fi

  echo -n "$newFilePath"
}

function _semantic_diff() {
  local oldGitPath
  local oldFilePath
  local newGitPath
  local newFilePath
  if [[ "$#" -eq 3 ]]; then
    oldGitPath="$1"
    oldFilePath="$2"
    newGitPath="$3"
    newFilePath="$newGitPath"
  elif [[ "$#" -eq 2 ]]; then
    set -x
    oldFilePath="$1"
    oldGitPath="$(basename "$oldFilePath")"
    newFilePath="$2"
    newGitPath="$(basename "$newFilePath")"
    echo "$@"
  fi
  local newPath
  local diff
  local unifiedDiff
  local filetype
  local tool
  local exitCode=0

  if newPath="$(runTextConversion "$oldFilePath" "$oldGitPath")"; then
    oldfilePath="$newPath"
  fi
  if newPath="$(runTextConversion "$newFilePath" "$newGitPath" "$oldGitPath")"; then
    newFilePath="$newPath"
  fi

  unifiedDiff="$(diff -u --unidirectional-new-file "$oldFilePath" "$newFilePath")" || exitCode=$?
  if [[ "$oldGitPath" != "$oldFilePath" ]]; then
    unifiedDiff="$(<<<"$unifiedDiff" sed -r "s#^--- $oldFilePath#--- $oldGitPath#")"
  fi
  if [[ "$newGitPath" != "$newFilePath" ]]; then
    unifiedDiff="$(<<<"$unifiedDiff" sed -r "s#^\+\+\+ $newFilePath#\+\+\+ $newGitPath#")"
  fi

  for path in "$oldFilePath" "$newFilePath"; do
    if [[ -f "$path" ]]; then
      filetype="$(xdg-mime query filetype "$path")"
      break
    fi
  done

  if [[ -v filetype ]] && tool="$(getToolForFileType "$filetype" "$oldFilePath" "$newFilePath")" && { "$tool" -e . "$oldFilePath" && "$tool" -e . "$newFilePath"; } &>/dev/null; then
    if declare -F "diffWith_$tool" >/dev/null; then
      diff="$("diffWith_$tool" "$oldFilePath" "$newFilePath")"
    else
      diff="$(diffWithDyff "$oldFilePath" "$newFilePath")"
    fi
    echo "$unifiedDiff" | (diff-so-fancy || true) | head -3
    echo "$diff"
  else
    echo "$unifiedDiff" | diff-so-fancy
  fi
  return "$exitCode"
}

if [[ -v 1 ]]; then
  if [[ "$(ps -o comm:1= -p "$PPID")" == "git" ]]; then
    _semantic_diff "$1" "$2" "$5" || true
  else
    _semantic_diff "$1" "$2"
  fi
else
  cat - | diff-so-fancy
fi
