#!/usr/bin/bash

set -x

if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
  locker=swaylock
else
  locker=i3lock
fi

lockscreenPicture=("-i" "$XDG_CONFIG_HOME/lock.png")

function unlock() {
  pkill --exact "$@" "$locker"
}

function lock() {
  if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
    swaylock -c 000000ff --scaling center "${lockscreenPicture[@]}" \
      --inside-color 00000000 --inside-ver-color 00000000 --inside-wrong-color 00000000
  else
    i3lock -c 000000 -C "${lockscreenPicture[@]}" \
      --pass-media-keys \
      --pass-screen-keys \
      --pass-volume-keys \
      --force-clock \
      --inside-color 00000000 --insidever-color 00000000 --insidewrong-color 00000000 \
      --date-str %F \
      --date-color ffffff \
      --time-color ffffff \
      --verif-text= --wrong-text= --noinput-text= \
      --redraw-thread
  fi
}

trap unlock TERM INT EXIT

if [[ "$XDG_SESSION_TYPE" != "wayland" ]] && [[ -n "${XSS_SLEEP_LOCK_FD}" ]]; then
  lock {XSS_SLEEP_LOCK_FD}<&-

  exec {XSS_SLEEP_LOCK_FD}<&-
else
  lock
fi

systemd-run --user --property=Requires=pause-notifications.service --scope --quiet --unit=lock -- \
  tail --pid=$(pgrep --newest --exact "$locker") -f /dev/null &

wait $!
