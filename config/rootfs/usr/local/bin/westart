#!/usr/bin/env bash

set -e

if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
  # Get focused window PID via compositor IPC
  # mmsg -g -c returns "appid title" — we need the PID from the process list
  client_info="$(mmsg -g -c 2>/dev/null)" || exit 1
  appid="$(awk '{print $1}' <<<"$client_info")"

  # Find PID by app_id match in process list
  if ! process_id="$(pgrep -f "$appid" | head -1)"; then
    exit 2
  fi
else
  if ! window_id="$(xdotool selectwindow)"; then
    exit 1
  fi

  if ! process_id="$(xprop -id "$window_id" _NET_WM_PID | awk '{print $3}')"; then
    exit 2
  fi
fi

if ! process_unit="$(ps -h -o uunit "$process_id")"; then
  exit 3
fi

case "$process_unit" in
  *.service)
    exec systemctl --user restart "$process_unit"
    ;;
  *.scope)
    exec systemctl --user stop "$process_unit"
    ;;
  -)
    exec kill "$process_id"
    ;;
esac
